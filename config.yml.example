# ============================================================
#  UoP Authentik HA Cluster Monitor — Site Configuration
#  Copy to config.yaml and fill in your values.
#  One file per site (config.site-a.yaml, config.site-b.yaml…)
# ============================================================

site_name: "UoP Authentik HA Cluster — Site A"

# Set to false if your terminal renders ● as underscores (common in Proxmox CTs without UTF-8 locale)
# Omit or set to true to auto-detect from locale env vars (LANG/LC_ALL/LC_CTYPE)
unicode_bullets: true

# Auto-refresh interval in seconds
refresh_interval: 20

# HTTP and Redis timeouts in seconds
http_timeout: 5
redis_timeout: 3

# VIP managed by keepalived
vip: "<your VIP>"

# Network interface keepalived runs on (used for display only)
vrrp_interface: "ens18"

nodes:
  authentik:
    - ip: "<node-1-ip>"
      name: "ak-node-1"
    - ip: "<node-2-ip>"
      name: "ak-node-2"
    - ip: "<node-3-ip>"
      name: "ak-node-3"

  patroni:
    - ip: "<node-1-ip>"
      name: "ak-node-1"
    - ip: "<node-2-ip>"
      name: "ak-node-2"
    - ip: "<node-3-ip>"
      name: "ak-node-3"

  etcd:
    - ip: "<node-1-ip>"
      name: "ak-node-1"
    - ip: "<node-2-ip>"
      name: "ak-node-2"
    - ip: "<node-3-ip>"
      name: "ak-node-3"

  haproxy:
    - ip: "<node-1-ip>"
      name: "ak-node-1"
    - ip: "<node-2-ip>"
      name: "ak-node-2"
    - ip: "<node-3-ip>"
      name: "ak-node-3"

  redis:
    - ip: "<node-4-ip>"
      name: "ak-node-4"
    - ip: "<node-5-ip>"
      name: "ak-node-5"
    - ip: "<node-6-ip>"
      name: "ak-node-6"

ports:
  authentik: 9443
  patroni: 8008
  etcd: 2379
  haproxy_stats: 9000
  redis: 6379
  sentinel: 26379
  nginx_status: 8080
  postgres: 5432

ssh:
  username: "your_ssh_username"
  key_file: "~/.ssh/id_ed25519"

# Services to collect logs from.
# type: "docker" (container name) or "systemd" (unit name)
# nodes: key from the nodes/keepalived sections above that lists the target hosts
services:
  - label: "Auth Server"
    nodes: authentik
    type: docker
    container: "authentik-server-1"
  - label: "Auth Worker"
    nodes: authentik
    type: docker
    container: "authentik-worker-1"
  - label: "Patroni"
    nodes: patroni
    type: systemd
    unit: "patroni"
  - label: "etcd"
    nodes: etcd
    type: docker
    container: "etcd"
  - label: "HAProxy"
    nodes: haproxy
    type: docker
    container: "haproxy"
  - label: "Nginx"
    nodes: authentik
    type: docker
    container: "nginx"
  - label: "Keepalived"
    nodes: keepalived
    type: systemd
    unit: "keepalived"
  - label: "Redis"
    nodes: redis
    type: docker
    container: "redis"
  - label: "Sentinel"
    nodes: redis
    type: docker
    container: "sentinel"

authentik:
  url: "https://authentik.example.com"   # Base URL of your Authentik instance (used by import_users.py)

credentials:
  haproxy_stats_user: "admin"
  haproxy_stats_pass: "your_haproxy_stats_password"
  redis_password: "your_redis_password"
  authentik_api_token: ""                # API token for import_users.py and monitor
  postgres_user: "postgres"
  postgres_password: "your_postgres_password"

sentinel:
  master_name: "mymaster"

keepalived:
  # Base priorities per node — must match your keepalived.conf
  # The monitor uses these to calculate effective priority
  # (effective = base - 20 if nginx is down, per weight -20 in track script)
  track_weight: -20
  nodes:
    - ip: "<node-1-ip>"
      name: "ak-node-1"
      base_priority: 100
    - ip: "<node-2-ip>"
      name: "ak-node-2"
      base_priority: 90
    - ip: "<node-3-ip>"
      name: "ak-node-3"
      base_priority: 80
